PORT=3000
# Set this in Azure App Service to use Cosmos DB instead of the local JSON fallback.
COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE=travelCatalogue
COSMOS_CONTAINER=destinations
# Set this to enable Azure Blob image uploads.
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
AZURE_STORAGE_CONTAINER=destination-images
# Copy the connection string from an Application Insights resource.
APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string
