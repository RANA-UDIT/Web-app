PORT=3000
# Leave the Cosmos settings empty to use the included local trails.json dataset.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=trekStop
COSMOS_CONTAINER=trails
# Obtain this key from an Azure Maps account. The server proxies map requests;
# this value is never returned to the browser. Do not commit your populated .env.
AZURE_MAPS_SUBSCRIPTION_KEY=
# Optional: enable Application Insights telemetry in Azure.
APPLICATIONINSIGHTS_CONNECTION_STRING=
